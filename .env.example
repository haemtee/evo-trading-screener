# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
# Admin Telegram chat/user ID (bot will ONLY respond to and notify this ID)
TELEGRAM_ADMIN_CHAT_ID=

# Binance Futures Demo Account API (https://testnet.binancefuture.com)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TRADE_URL=https://testnet.binancefuture.com
BINANCE_MARKET_DATA_URL=https://testnet.binancefuture.com
BINANCE_WS_URL=wss://fstream.binancefuture.com
WATCHLIST_REFRESH_MINUTES=15
# Optional overrides if your network can reach binance.com directly:
# BINANCE_TRADE_URL=https://demo-fapi.binance.com
# BINANCE_MARKET_DATA_URL=https://fapi.binance.com

# SQLite Database
DB_PATH=./data/screener.sqlite

# Strategy & Risk Defaults
MIN_VOLUME_USD=5000000
TOP_N=10
EMA_PERIOD=21
RISK_PCT=1
RR_RATIO=2
LEVERAGE=5
MAX_OPEN_POSITIONS=3
AUTO_TRADE=false

# Capital Protection & Signal Quality
DAILY_MAX_LOSS_PCT=3
MAX_CONSECUTIVE_LOSSES=3
LOSS_COOLDOWN_MINUTES=90
SYMBOL_COOLDOWN_MINUTES=180
BREAK_EVEN_AT_R=1
MIN_SL_PCT=1
MAX_NOTIONAL_EQUITY_MULT=2
MIN_24H_CHANGE_PCT=5
MAX_24H_CHANGE_PCT=25
